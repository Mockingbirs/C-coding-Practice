#include <stdio.h>
 
typedef union unum    // 공용체 선언
{
    int a;
    int b;
    double c;
} Unum;
 
int main(void)
{
    Unum un;    // 8바이트 메모리 할당
 
    un.a = 10;
    printf("%d\n", un.b);    // b 멤버 출력
 
    un.c = 11.1;    // c 멤버에 값 대입
    printf("%d\n", un.a);    // a 멤버 출력
    printf("%d\n", un.b);    // b 멤버 출력
    printf("%f\n", un.c);    // c 멤버 출력
 
    return 0;
}
