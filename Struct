#include <stdio.h>
 
typedef struct snum    // 구조체 선언
{
    int a;
    int b;
    double c;
} Snum;
 
typedef union unum    // 공용체 선언
{
    int a;
    int b;
    double c;
} Unum;
 
int main(void)
{
    Snum sn;
    Unum un;
    printf("%p %p %p\n", &sn.a, &sn.b, &sn.c);
    printf("%p %p %p\n", &un.a, &un.b, &un.c);
    printf("%d %d\n", sizeof(Snum), sizeof(Unum));
 
    return 0;
}
 



